# packwiz exports
*.mrpack
*.zip
dist/

# packwiz local cache
.packwiz-cache/

# Publish credentials — never commit
.env

# Python (scripts/publish.py)
__pycache__/
*.pyc
.venv/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Minecraft local client state (not pack content). Anchored to pack root with a
# leading slash so these match ONLY the maintainer's personal saved-server list
# written here by packwiz — NOT the seeded default at
# config/defaultoptions/extra/servers.dat (an unanchored pattern matches at any
# depth and silently strips that seeded file from the build).
/servers.dat
/servers.dat_old
