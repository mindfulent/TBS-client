# TheBlockSurvival publish credentials — copy to .env and fill in.
# .env is gitignored. Used by scripts/publish.py.

# Modrinth personal access token with the "Create version" scope.
# Generate at https://modrinth.com/settings/pats
MODRINTH_TOKEN=

# Modrinth project slug or ID. Create the modpack project on modrinth.com first,
# then put its slug here. Defaults to "theblocksurvival" if unset.
MODRINTH_PROJECT=theblocksurvival

# CurseForge upload token. Generate at
# https://authors-old.curseforge.com/account/api-tokens
# (only needed for --platform curseforge / both)
CURSEFORGE_TOKEN=

# CurseForge numeric project ID. Shown on the CurseForge project dashboard
# once the modpack project is created.
CURSEFORGE_PROJECT_ID=
