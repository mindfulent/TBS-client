# Files in the repo that are NOT part of the distributed modpack.
# packwiz indexes the whole pack directory by default; this keeps maintainer
# tooling, credentials, and build output out of the exported .mrpack / .zip.
# (README.md, CHANGELOG.md, and docs/ are intentionally NOT ignored — they are
# small, player-readable, and have shipped since v1.0.)

# Publish automation + its docs
scripts/
PUBLISHING.md

# Safety net: TBS-Client is a Fabric modpack, plugins/ should always be empty.
# `cf install <slug>` of a Bukkit-category project (e.g. Simple Voice Chat)
# drops a stray .pw.toml here that poisons the CurseForge manifest with a
# Bukkit project reference — CF rejects modpacks containing such references.
# Ignore plugins/ so a stray cf install can't break a release.
plugins/

# Credentials
.env
.env.example

# Claude Code / repo guidance — not player-facing
CLAUDE.md

# Python venv (created by `pip install -r scripts/requirements.txt` per
# PUBLISHING.md). Without this, `packwiz refresh` scoops up the entire
# 4,000+-file virtualenv tree and embeds it under `overrides/.venv/` in
# every exported .mrpack.
.venv/

# packwiz binaries themselves. The Windows .exe is checked in for that
# platform; on macOS / Linux, maintainers typically symlink `packwiz` to
# their native binary at the pack root so scripts/publish.py picks it up
# (publish.py looks for `./packwiz` first, then globs `packwiz*`). Neither
# should ever ride in the distributed .mrpack.
packwiz
packwiz.exe

# Minecraft local client state — a maintainer's personal saved-server list,
# written into the pack root when packwiz is run from a live game instance.
# Not pack content; must never ride in the distributed .mrpack.
servers.dat
servers.dat_old

# Build output and VCS
dist/
.git/
.gitignore
.packwiz-cache/
